---
/**
 * Inline SVG charts, driven entirely by report frontmatter.
 *
 * No charting library: the site stays dependency-free, works offline, prints
 * well, and the output is portable to any host. Two shapes cover almost
 * everything a daily report needs — `bar` and `line`.
 */
interface ChartPoint {
  label: string;
  value: number;
}

interface Props {
  title: string;
  type?: 'bar' | 'line';
  unit?: string;
  data: ChartPoint[];
}

const { title, type = 'bar', unit = '', data } = Astro.props;

const WIDTH = 640;
const HEIGHT = 260;
const PAD_LEFT = 46;
const PAD_RIGHT = 12;
const PAD_TOP = 22;
const PAD_BOTTOM = 38;
const PLOT_W = WIDTH - PAD_LEFT - PAD_RIGHT;
const PLOT_H = HEIGHT - PAD_TOP - PAD_BOTTOM;

const values = data.map((point) => point.value);
const dataMax = Math.max(...values, 0);
const dataMin = Math.min(...values, 0);

// A flat series (all values equal) would divide by zero, so give it a floor.
const rawSpan = dataMax - dataMin || Math.abs(dataMax) || 1;
const pad = rawSpan * 0.08;
const max = dataMax + pad;
const min = dataMin - (dataMin < 0 ? pad : 0);
const span = max - min;

const scaleY = (value: number) => PAD_TOP + PLOT_H - ((value - min) / span) * PLOT_H;

const formatNumber = (value: number) => {
  const rounded = Math.round(value * 10) / 10;
  return String(Number.isInteger(rounded) ? rounded : rounded.toFixed(1));
};

const format = (value: number) => `${formatNumber(value)}${unit}`;

// Four bands are enough to read a value without turning the card into a grid.
const tickCount = 4;
const ticks = Array.from({ length: tickCount + 1 }, (_, index) => {
  const value = min + (span / tickCount) * index;
  return { value, y: scaleY(value) };
});

// Bar geometry: equal slots, each bar inset a little so they breathe.
const slot = PLOT_W / Math.max(data.length, 1);
const barGap = Math.min(14, slot * 0.3);
const barWidth = Math.max(6, slot - barGap);

// Line geometry.
const step = data.length > 1 ? PLOT_W / (data.length - 1) : 0;
const points = data.map((point, index) => ({
  x: PAD_LEFT + (data.length > 1 ? index * step : PLOT_W / 2),
  y: scaleY(point.value),
  ...point,
}));

const linePath = points.map((point) => `${point.x},${point.y}`).join(' ');
const baseline = PAD_TOP + PLOT_H;
const areaPath = `M${points[0]?.x ?? PAD_LEFT},${baseline} L${linePath.replace(/ /g, ' L')} L${
  points.at(-1)?.x ?? PAD_LEFT + PLOT_W
},${baseline} Z`;

// With many categories, thin the axis labels instead of overlapping them.
const labelEvery = data.length > 9 ? 2 : 1;
const truncate = (label: string) => (label.length > 12 ? `${label.slice(0, 11)}…` : label);
---

<figure class="chart">
  <figcaption class="chart__title">
    {title}{unit && <span class="chart__unit"> · {unit.trim()}</span>}
  </figcaption>

  <svg
    class="chart__svg"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    role="img"
    aria-label={`${title}: ${data.map((point) => `${point.label} ${format(point.value)}`).join(', ')}`}
  >
    <!-- Value grid -->
    {
      ticks.map((tick) => (
        <g>
          <line
            class="chart__grid"
            x1={PAD_LEFT}
            y1={tick.y}
            x2={PAD_LEFT + PLOT_W}
            y2={tick.y}
          />
          <text class="chart__tick" x={PAD_LEFT - 9} y={tick.y + 3.5} text-anchor="end">
            {formatNumber(tick.value)}
          </text>
        </g>
      ))
    }

    <line class="chart__axis" x1={PAD_LEFT} y1={baseline} x2={PAD_LEFT + PLOT_W} y2={baseline} />

    {
      type === 'line' ? (
        <>
          <path class="chart__area" d={areaPath} />
          <polyline class="chart__line" points={linePath} />
          {points.map((point) => (
            <circle class="chart__dot" cx={point.x} cy={point.y} r="4">
              <title>{`${point.label}: ${format(point.value)}`}</title>
            </circle>
          ))}
        </>
      ) : (
        data.map((point, index) => {
          const x = PAD_LEFT + index * slot + barGap / 2;
          const y = scaleY(point.value);
          const height = Math.max(2, baseline - y);

          return (
            <g>
              <rect class="chart__bar" x={x} y={y} width={barWidth} height={height} rx="4">
                <title>{`${point.label}: ${format(point.value)}`}</title>
              </rect>
              <text class="chart__tick" x={x + barWidth / 2} y={y - 7} text-anchor="middle">
                {format(point.value)}
              </text>
            </g>
          );
        })
      )
    }

    {
      data.map((point, index) => (
        <text
          class="chart__tick"
          x={PAD_LEFT + index * slot + slot / 2}
          y={baseline + 19}
          text-anchor="middle"
        >
          {index % labelEvery === 0 ? truncate(point.label) : ''}
        </text>
      ))
    }
  </svg>
</figure>
