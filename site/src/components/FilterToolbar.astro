---
import Icon from '../components/Icon.astro';
import { tagCounts, type Report } from '../lib/site';

interface Props {
  reports: Report[];
  /** Placeholder for the search box. */
  placeholder?: string;
}

const { reports, placeholder = 'Search the archive…' } = Astro.props;
const tags = tagCounts(reports);
const total = reports.length;
---

<div class="toolbar" data-toolbar>
  <div class="filters" role="group" aria-label="Filter by tag">
    <button class="pill" type="button" data-filter="all" aria-pressed="true">
      All <span class="pill__count">{total}</span>
    </button>
    {
      tags.map((tag) => (
        <button class="pill" type="button" data-filter={tag.tag.toLowerCase()} aria-pressed="false">
          {tag.tag} <span class="pill__count">{tag.count}</span>
        </button>
      ))
    }
  </div>

  <label class="search">
    <span class="search__icon"><Icon name="search" /></span>
    <input
      type="search"
      placeholder={placeholder}
      data-search-input
      aria-label="Search reports by title, summary or tag"
      autocomplete="off"
    />
  </label>
</div>

<p class="empty" data-empty hidden>Nothing matches that filter yet.</p>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-report-card]'));
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (cards.length) {
    let activeTag = 'all';

    const apply = () => {
      const query = (input?.value ?? '').trim().toLowerCase();

      let visible = 0;

      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').toLowerCase().split(/\s+/).filter(Boolean);
        const matchesTag = activeTag === 'all' || tags.includes(activeTag);
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const show = matchesTag && matchesQuery;

        card.hidden = !show;
        if (show) visible += 1;
      }

      if (empty) empty.hidden = visible > 0;

      // On the archive page, hide month headings that no longer have matches.
      for (const group of document.querySelectorAll<HTMLElement>('[data-group]')) {
        const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('[data-report-card]')).some(
          (card) => !card.hidden,
        );
        group.hidden = !anyVisible;
      }

      // Keep the URL honest without adding history entries.
      const url = new URL(window.location.href);
      if (activeTag === 'all') url.searchParams.delete('tag');
      else url.searchParams.set('tag', activeTag);
      window.history.replaceState(null, '', url);
    };

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        activeTag = pill.dataset.filter ?? 'all';
        for (const other of pills) {
          other.setAttribute('aria-pressed', String(other === pill));
        }
        apply();
      });
    }

    input?.addEventListener('input', apply);

    // Honour a ?tag= link, so tags can be shared.
    const initial = new URL(window.location.href).searchParams.get('tag');
    if (initial) {
      const match = pills.find((pill) => pill.dataset.filter === initial.toLowerCase());
      if (match) {
        match.click();
      } else {
        apply();
      }
    }
  }
</script>
