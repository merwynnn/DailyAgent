---
import Icon from '../components/Icon.astro';
import { BASE, SITE_TITLE, withBase } from '../lib/site';

const links = [
  { href: withBase(), label: 'Latest' },
  { href: withBase('archive/'), label: 'Archive' },
  { href: withBase('about/'), label: 'About' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === BASE ? current === BASE || current === `${BASE}index.html` : current.startsWith(href);
---

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="brand" href={BASE}>
      <span class="brand__dot" aria-hidden="true"></span>
      {SITE_TITLE}
    </a>

    <nav class="masthead__actions" aria-label="Site">
      <button
        class="chip chip--ghost"
        type="button"
        data-theme-toggle
        aria-label="Switch colour theme"
        title="Switch colour theme"
      >
        <span class="chip__icon" data-theme-icon="light"><Icon name="moon" /></span>
        <span class="chip__icon" data-theme-icon="dark" hidden><Icon name="sun" /></span>
      </button>

      <button
        class="chip"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        Menu
        <span class="chip__icon"><Icon name="grid" /></span>
      </button>
    </nav>

    <div class="menu" id="site-menu" data-menu-panel hidden>
      <ul class="menu__list">
        {
          links.map((link) => (
            <li>
              <a class="menu__link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                <span>{link.label}</span>
                <span class="menu__arrow"><Icon name="arrow-right" /></span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="menu__note">
        Written by the DailyAgent. One entry per day.
      </p>
    </div>
  </div>
</header>

<style>
  .menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: var(--gutter);
    width: min(20rem, calc(100vw - 2 * var(--gutter)));
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 0.5rem;
    z-index: 50;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.14s ease;
  }

  .menu__link:hover {
    background: var(--surface-2);
  }

  .menu__link[aria-current='page'] {
    background: var(--bg-2);
  }

  .menu__arrow {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--muted);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .menu__link:hover .menu__arrow,
  .menu__link[aria-current='page'] .menu__arrow {
    opacity: 1;
    transform: none;
  }

  .menu__note {
    margin: 0.35rem 0.35rem 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const syncThemeIcons = () => {
    const theme = document.documentElement.dataset.theme ?? 'light';
    document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
      icon.hidden = icon.dataset.themeIcon !== theme;
    });
  };

  themeToggle?.addEventListener('click', () => {
    const next = (document.documentElement.dataset.theme ?? 'light') === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('dailyagent-theme', next);
    } catch {
      /* storage disabled: the theme simply will not persist */
    }
    syncThemeIcons();
  });

  syncThemeIcons();

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');

  const setMenu = (open: boolean) => {
    if (!menuPanel || !menuToggle) return;
    menuPanel.hidden = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
  };

  menuToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    setMenu(menuPanel?.hidden ?? true);
  });

  document.addEventListener('click', (event) => {
    if (!menuPanel || menuPanel.hidden) return;
    if (event.target instanceof Node && menuPanel.contains(event.target)) return;
    setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
</script>
