---
import Chart from '../components/Chart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, publishedReports, reportUrl } from '../lib/site';
import { getCollection } from 'astro:content';

// Reports that carried at least one chart, newest first, with their charts.
const charted = publishedReports(await getCollection('reports')).filter(
  (report) => report.data.charts?.length > 0,
);
const total = charted.reduce((sum, report) => sum + report.data.charts.length, 0);

// Tags actually present on charted reports, for the filter row.
const usedTags = [...new Set(charted.flatMap((report) => report.data.tags))].sort();
---

<BaseLayout
  title="By the numbers"
  description="Every chart the daily log has rendered, collected on one page and linked back to the day that sourced it."
>
  <div class="wrap">
    <section class="page-head">
      <p class="eyebrow">{total} charts · {charted.length} reports</p>
      <h1>By the numbers</h1>
      <p class="page-head__lede">
        Every figure the daily log has rendered, curated onto one page as the log accumulates.
        Each entry links back to the day that sourced the data — vendor-reported figures stay
        labelled as such, exactly as they were in print.
      </p>

      <div class="numbers__filter" data-chart-filter role="group" aria-label="Filter charts by tag">
        <button type="button" class="numbers__chip" data-filter-tag="" aria-pressed="true">All</button>
        {usedTags.map((tag) => (
          <button type="button" class="numbers__chip" data-filter-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
      <noscript>
        <style>[data-chart-filter]{display:none;}</style>
      </noscript>
    </section>

    {
      charted.map((report) => (
        <section class="numbers" data-report-tags={report.data.tags.join(' ')}>
          <p class="numbers__date">
            <a href={reportUrl(report)}>{formatDate(report.data.date)}</a>
          </p>
          <div class="charts">
            {report.data.charts.map((chart) => (
              <Chart title={chart.title} type={chart.type} unit={chart.unit} data={chart.data} />
            ))}
          </div>
        </section>
      ))
    }

    {
      charted.length === 0 && (
        <p class="numbers__empty">No charts yet — numbers arrive with the days that earn them.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .numbers {
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .numbers__date {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .numbers__date a {
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .numbers__date a:hover {
    color: var(--ink);
  }

  .numbers__empty {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .numbers__filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .numbers__chip {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    padding: 0.25rem 0.75rem;
    cursor: pointer;
  }

  .numbers__chip:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .numbers__chip[aria-pressed='true'] {
    color: var(--on-gold);
    background: var(--gold);
    border-color: var(--gold-deep);
  }
</style>

<script>
  // Tag filter for the charts below. Progressive enhancement: without
  // JavaScript the chips row is hidden and every chart stays visible.
  const filterRow = document.querySelector('[data-chart-filter]');
  const chips = filterRow ? Array.from(filterRow.querySelectorAll('[data-filter-tag]')) : [];
  const sections = Array.from(document.querySelectorAll('[data-report-tags]'));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.filterTag;
      chips.forEach((el) => el.setAttribute('aria-pressed', String(el === chip)));
      sections.forEach((section) => {
        const tags = (section.dataset.reportTags || '').split(' ');
        section.hidden = Boolean(tag) && !tags.includes(tag);
      });
    });
  });
</script>
