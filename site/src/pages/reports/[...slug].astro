---
import { getCollection, render } from 'astro:content';

import Chart from '../../components/Chart.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  assetUrl,
  formatDateLong,
  publishedReports,
  readingTime,
  reportUrl,
  tagUrl,
  withBase,
  type Report,
} from '../../lib/site';

export async function getStaticPaths() {
  const published = publishedReports(await getCollection('reports'));

  return published.map((report, index) => ({
    params: { slug: report.id },
    props: {
      report,
      newer: (published[index - 1] ?? null) as Report | null,
      older: (published[index + 1] ?? null) as Report | null,
      /** Newest-first, ranked by how many tags they share, then recency. */
      related: published
        .filter((other) => other.id !== report.id)
        .map((other) => ({
          report: other,
          shared: other.data.tags.filter((tag) => report.data.tags.includes(tag)).length,
        }))
        .filter((entry) => entry.shared > 0)
        .sort((a, b) => b.shared - a.shared || b.report.id.localeCompare(a.report.id))
        .slice(0, 3)
        .map((entry) => entry.report),
    },
  }));
}

const { report, newer, older, related } = Astro.props;
const { Content } = await render(report);
const { title, date, summary, tags, hero, heroAlt, charts, sources } = report.data;

const minutes = readingTime(report.body);
---

<BaseLayout
  title={title}
  description={summary}
  progress
  ogImage={hero ? assetUrl(hero) : undefined}
  ogType="article"
  publishedTime={date}
>
  <article class="article wrap">
    <header class="article__head">
      <p class="article__back">
        <a href={withBase('archive/')}>
          <span class="article__back-icon"><Icon name="arrow-left" /></span> All reports
        </a>
      </p>

      <div class="article__meta">
        <span class="badge badge--solid">{formatDateLong(date)}</span>
        {tags.map((tag) => <a class="badge" href={tagUrl(tag)}>{tag}</a>)}
        <span class="article__reading">{minutes} min read</span>
      </div>

      <h1 class="article__title">{title}</h1>
      <p class="article__lede">{summary}</p>
    </header>

    {
      hero && (
        <div class="article__hero">
          <img src={assetUrl(hero)} alt={heroAlt ?? ''} loading="eager" decoding="async" />
        </div>
      )
    }

    <div class="article__body prose">
      <Content />
    </div>

    {
      charts.length > 0 && (
        <div class="charts">
          {charts.map((chart) => (
            <Chart title={chart.title} type={chart.type} unit={chart.unit} data={chart.data} />
          ))}
        </div>
      )
    }

    {
      sources.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ol>
            {sources.map((source, index) => (
              <li>
                <span class="sources__index">{String(index + 1).padStart(2, '0')}</span>
                <a href={source.url} rel="noopener noreferrer" target="_blank">
                  {source.label}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <h2>Related</h2>
          <ul class="related__list">
            {related.map((entry) => (
              <li class="related__item">
                <span class="related__date">{entry.data.date}</span>
                <a class="related__link" href={reportUrl(entry)}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (newer || older) && (
        <nav class="pager" aria-label="Other reports">
          {older && (
            <a class="pager__link" href={reportUrl(older)}>
              <span class="pager__label">← Older</span>
              <span class="pager__title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="pager__link pager__link--next" href={reportUrl(newer)}>
              <span class="pager__label">Newer →</span>
              <span class="pager__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .article__back {
    font-size: 0.82rem;
    margin-bottom: 1.1rem;
  }

  .article__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--muted);
  }

  .article__back a:hover {
    color: var(--ink);
  }

  .article__back-icon {
    width: 0.9rem;
    height: 0.9rem;
    display: inline-flex;
  }

  .article__reading {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .related__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.92rem;
  }

  .related__date {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .related__link {
    color: var(--ink);
    text-decoration: none;
  }

  .related__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold, currentColor);
  }
</style>

<script>
  // Widget bridge. Panels live in iframes with their own document, so the page
  // has to tell them two things: the current theme, and how tall they are.
  const frames = () => Array.from(document.querySelectorAll('iframe[data-widget-frame]'));

  const pushTheme = () => {
    const theme = document.documentElement.dataset.theme ?? 'light';
    for (const frame of frames()) {
      frame.contentWindow?.postMessage({ type: 'dailyagent:theme', theme }, '*');
    }
  };

  // A panel calls DAKit.fit() when its content is taller than the frame it was
  // given; growing here is what keeps it from scrolling inside itself.
  window.addEventListener('message', (event) => {
    const data = event.data;
    if (!data || data.type !== 'dailyagent:height') return;

    const frame = frames().find((candidate) => candidate.contentWindow === event.source);
    const height = Math.round(Number(data.height));
    if (!frame || !Number.isFinite(height) || height <= 0) return;

    const box = frame.closest('.widget__frame');
    if (box) box.style.setProperty('--widget-h', `${Math.min(Math.max(height, 160), 1400)}px`);
  });

  for (const frame of frames()) frame.addEventListener('load', pushTheme);

  new MutationObserver(pushTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
